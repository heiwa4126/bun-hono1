{
	"name": "bun-hono1",
	"scripts": {
		"start": "bun run src/index.ts",
		"dev": "bun run --hot src/index.ts",
		"format": "oxfmt",
		"lint": "oxlint",
		"check": "oxfmt && oxlint --fix",
		"build": "bun build ./src/index.ts --outfile ./dist/index.js --minify --target bun",
		"preview": "bun run ./dist/index.js",
		"compile": "bun build ./src/index.ts --minify --target bun --outfile dist/bun-hono1",
		"exec": "./dist/bun-hono1"
	},
	"dependencies": {
		"hono": "^4.13.0"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14"
	}
}
