{
	"name": "bun-hono1",
	"scripts": {
		"start": "bun run src/index.ts",
		"dev": "bun run --hot src/index.ts",
		"format": "oxfmt",
		"lint": "oxlint",
		"check": "oxfmt && oxlint --fix",
		"build": "bun build ./src/index.ts --outfile ./dist/index.js --minify --target bun",
		"preview": "bun run ./dist/index.js",
		"compile": "bun build ./src/index.ts --minify --target bun --compile --outfile dist/bun-hono1",
		"exec": "./dist/bun-hono1",
		"shellcheck": "shellcheck -x -s bash script/*.sh && shfmt -w script/*.sh",
		"shfmt": "shfmt -w script/*.sh",
		"create-user": "script/create-user.sh",
		"install": "script/install-app.sh",
		"update": "script/update-app.sh",
		"status": "LANG=C systemctl status bun-hono1",
		"journal": "LANG=C journalctl -u bun-hono1",
		"delete": "script/delete-app.sh"
	},
	"dependencies": {
		"hono": "^4.13.0"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14"
	}
}
